    "react-dom": "^18.3.1",
    "react-qr-code": "^2.0.15",
    "vazirmatn": "33.0.3",
    "qr-code-styling": "1.9.2",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "@types/leaflet": "^1.9.14"
  },
  "engines": {
    "node": ">=18.18.0"
  }
